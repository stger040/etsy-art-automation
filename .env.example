# --- Database (Neon Postgres) ---
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Pipeline config ---
LISTINGS_PER_DAY=1
# Master kill switch. Must be the literal string "true" for /api/pipeline/run
# to do anything beyond a no-op — keep unset/false until Etsy + Printify
# credentials are configured, so the daily cron doesn't burn Claude/Recraft/
# Replicate credits generating art with nowhere to publish yet.
PIPELINE_ENABLED=false
# Shared secret required as a Bearer token or ?secret= query param on /api/pipeline/run
# so the cron endpoint can't be triggered by randoms. Vercel Cron sends this automatically
# via the CRON_SECRET convention (Authorization: Bearer $CRON_SECRET).
CRON_SECRET=

# --- Claude API (theme/listing generation + vision compliance check) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- Recraft (base image generation) ---
RECRAFT_API_KEY=

# --- Replicate (Real-ESRGAN upscaling) ---
REPLICATE_API_TOKEN=

# --- Vercel Blob (final image storage) ---
BLOB_READ_WRITE_TOKEN=

# --- Canva Connect API (digital mockup autofill/export) ---
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REFRESH_TOKEN=
CANVA_MOCKUP_TEMPLATE_ID=
# Name of the image field on the brand template, as returned by
# get-brand-template-dataset. Defaults to "image".
CANVA_IMAGE_FIELD_NAME=image

# --- Etsy Open API v3 (digital listing creation) ---
ETSY_API_KEY=
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_SHOP_ID=
# Etsy taxonomy (category) ID for the digital listings, e.g. "Digital Prints".
# Look this up via GET /v3/application/seller-taxonomy/nodes or your shop's
# existing listings.
ETSY_TAXONOMY_ID=
ETSY_DIGITAL_PRICE=8.00

# --- Printify (physical print-on-demand listings) ---
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
# Printify catalog blueprint + print provider IDs for the POD products to create.
# Defaults below target a popular poster + canvas combo; override per your catalog.
PRINTIFY_POSTER_BLUEPRINT_ID=97
PRINTIFY_POSTER_PRINT_PROVIDER_ID=1
PRINTIFY_CANVAS_BLUEPRINT_ID=196
PRINTIFY_CANVAS_PRINT_PROVIDER_ID=1
# Flat retail price applied to every variant, in cents.
PRINTIFY_DEFAULT_PRICE_CENTS=4500
