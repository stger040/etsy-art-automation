# --- Database (Neon Postgres) ---
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Pipeline config ---
LISTINGS_PER_DAY=1
# Master kill switch. Must be the literal string "true" for /api/pipeline/run
# to do anything beyond a no-op — keep unset/false until Etsy + Printify
# credentials are configured, so the daily cron doesn't burn Claude/Recraft/
# Replicate credits generating art with nowhere to publish yet.
PIPELINE_ENABLED=false
# Branch toggles: which listing type(s) to publish per approved design.
# Both default true; set to false to skip a branch entirely.
PIPELINE_ENABLE_DIGITAL=true
PIPELINE_ENABLE_PHYSICAL=true
# Fraction (0-1) of designs generated as landscape/horizontal instead of
# portrait/vertical, picked randomly per design. Default 0.5 (even mix).
PIPELINE_LANDSCAPE_PROBABILITY=0.5
# Fraction (0-1) of designs whose Canva mockup uses the dark "man cave" room
# style instead of the light one, picked randomly per design (independent of
# orientation). Default 0.3 (dark stays a minority style).
PIPELINE_DARK_MOCKUP_PROBABILITY=0.3
# Shared secret required as a Bearer token or ?secret= query param on /api/pipeline/run
# so the cron endpoint can't be triggered by randoms. Vercel Cron sends this automatically
# via the CRON_SECRET convention (Authorization: Bearer $CRON_SECRET).
CRON_SECRET=

# --- Claude API (theme/listing generation + vision compliance check) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- Recraft (base image generation) ---
RECRAFT_API_KEY=
# Orientation is picked randomly per design (see PIPELINE_LANDSCAPE_PROBABILITY
# below), so both a portrait and a landscape size need to be valid Recraft
# size strings. Defaults are the largest options matching a 3:4 / 4:3 ratio —
# verify against the current Recraft API reference before relying on them.
RECRAFT_SIZE=1024x1365
RECRAFT_SIZE_HORIZONTAL=1365x1024

# --- Replicate (Real-ESRGAN upscaling) ---
REPLICATE_API_TOKEN=

# --- Vercel Blob (final image storage) ---
BLOB_READ_WRITE_TOKEN=

# --- Canva Connect API (digital mockup autofill/export) ---
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REFRESH_TOKEN=
CANVA_MOCKUP_TEMPLATE_ID=
# Landscape counterpart of CANVA_MOCKUP_TEMPLATE_ID, used when a design's
# randomly-picked orientation is landscape — a portrait-framed mockup would
# badly crop/stretch a landscape image.
CANVA_MOCKUP_TEMPLATE_ID_HORIZONTAL=
# Dark "man cave" room style counterparts, used when a design's
# randomly-picked mockup style is dark (PIPELINE_DARK_MOCKUP_PROBABILITY).
# Build these the same way as the two above, just a dark moody room instead
# of a light one.
CANVA_MOCKUP_TEMPLATE_ID_DARK=
CANVA_MOCKUP_TEMPLATE_ID_DARK_HORIZONTAL=
# Name of the image field on the brand template, as returned by
# get-brand-template-dataset. Defaults to "image".
CANVA_IMAGE_FIELD_NAME=image

# --- Etsy Open API v3 (digital listing creation) ---
ETSY_API_KEY=
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_SHOP_ID=
# Etsy taxonomy (category) ID for the digital listings, e.g. "Digital Prints".
# Look this up via GET /v3/application/seller-taxonomy/nodes or your shop's
# existing listings.
ETSY_TAXONOMY_ID=
ETSY_DIGITAL_PRICE=8.00

# --- Printify (physical print-on-demand listings) ---
PRINTIFY_API_TOKEN=
PRINTIFY_SHOP_ID=
# Which physical product types to create per approved design. Both default
# true; set either to false to skip it (e.g. canvas-only for now).
PRINTIFY_ENABLE_POSTER=true
PRINTIFY_ENABLE_CANVAS=true
# Printify catalog blueprint + print provider IDs for the POD products to create.
# Defaults below target a popular poster + canvas combo; override per your catalog.
PRINTIFY_POSTER_BLUEPRINT_ID=97
PRINTIFY_POSTER_PRINT_PROVIDER_ID=1
PRINTIFY_CANVAS_BLUEPRINT_ID=196
PRINTIFY_CANVAS_PRINT_PROVIDER_ID=1
# Every variant (across poster/canvas/shirt) is priced at cost / (1 - margin),
# so profit margin stays constant across sizes instead of a flat price that
# loses money on larger, more expensive-to-produce sizes. Printify's catalog
# doesn't expose cost ahead of time — it's only revealed in the response of
# actually creating a product — so cost is read from that response and the
# product's prices are updated to match before it's published.
PRINTIFY_PROFIT_MARGIN=0.30
# Used only as a fallback if Printify's response is ever missing a variant's
# cost (shouldn't normally happen).
PRINTIFY_DEFAULT_PRICE_CENTS=4500

# Optional: also create a t-shirt product. Leave PRINTIFY_SHIRT_BLUEPRINT_ID
# unset to skip shirts entirely. Apparel print areas are proportioned very
# differently from a 4500x6000 poster image, so PRINTIFY_SHIRT_IMAGE_SCALE
# (fraction of the print area the art should fill, default 0.8) will likely
# need tuning after checking the first product's preview in Printify.
PRINTIFY_SHIRT_BLUEPRINT_ID=
PRINTIFY_SHIRT_PRINT_PROVIDER_ID=1
PRINTIFY_SHIRT_IMAGE_SCALE=0.8
